{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('meta/createdBy').val() === auth.uid",
        ".validate": "$room.matches(/^[a-z0-9-]{3,40}$/)",
        "meta": {
          ".write": "auth != null && data.child('createdBy').val() === auth.uid",
          "team": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" }
        },
        "round": {
          ".write": "auth != null && root.child('rooms/' + $room + '/players/' + auth.uid + '/name').exists()"
        },
        "history": {
          ".write": "auth != null && root.child('rooms/' + $room + '/players/' + auth.uid + '/name').exists()"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" }
          }
        },
        "votes": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            ".validate": "newData.hasChildren(['value', 'round']) && newData.child('value').isString() && newData.child('value').val().length <= 3"
          }
        }
      }
    },
    "nudges": {
      "$room": {
        "$to": {
          ".read": "auth != null && auth.uid === $to",
          ".write": "auth != null && (auth.uid === $to || root.child('rooms/' + $room + '/players/' + auth.uid + '/name').exists())",
          "$id": {
            ".validate": "newData.hasChildren(['from', 'at']) && newData.child('from').val() === auth.uid"
          }
        }
      }
    }
  }
}
